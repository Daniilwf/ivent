# Copy to .env next to it and fill in; .env is never committed (gitleaks checks). Used by deploy/docker-compose.yml:
#   docker compose -f deploy/docker-compose.yml --env-file .env up -d --build

# The image tags the live site and the test copy run (CI sets them: the test copy gets a new version first, the live
# site only one that passed it); locally «local»
SITE_VERSION=local
STAGING_VERSION=local

# Domains of the live site and the test copy; locally localhost and staging.localhost
SITE_DOMAIN=localhost
STAGING_DOMAIN=staging.localhost

# Covers and hours (D-118), optional: without them the site works, the admin enters hours and covers by hand
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
HLTB_SEARCH_URL=
