# One .gitignore for the whole repository (web/ and e2e/ have none of their own).

# --- Personal data and secrets: never in the public repository ---
data/import/*
!data/import/.gitkeep
.env
.env.*
!.env.example
deploy/secrets/
appsettings.*.local.json
*.pem
*.key
*.pfx
*.xlsx

# --- Local databases, backups, logs ---
/var/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-*
design-time.db*
*.bak
backups/
logs/
*.log

# --- .NET build output and caches ---
bin/
obj/
TestResults/
StrykerOutput/
.nuget/

# --- Node ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*

# --- Test output (Playwright traces, coverage, Stryker reports) ---
test-artifacts/
playwright-report/
blob-report/
coverage/

# --- Downloaded tools (gitleaks) ---
.tools/

# --- Editors and OS ---
.vs/
*.user
*.suo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Claude Code local state ---
.claude/state/
.claude/settings.local.json
