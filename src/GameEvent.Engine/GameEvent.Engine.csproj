<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure rules library: no ASP.NET, EF, file system or network. Time and randomness come through abstractions. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The default ruleset lives in docs/ (source of truth) and ships inside the engine. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/ruleset.default.json" LogicalName="ruleset.default.json" Link="Rulesets/ruleset.default.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameEvent.Engine.Tests" />
  </ItemGroup>

</Project>
