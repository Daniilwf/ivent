{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Main": "Data Source=var/game-event.db"
  },
  "Security": {
    "LoginAttemptsPerMinute": 10
  },
  "Backup": {
    "Path": "var/backups",
    "Keep": 14
  },
  "Scheduler": {
    "Enabled": true,
    "IntervalSeconds": 5
  }
}
